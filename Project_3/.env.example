# Copy to .env (git-ignored). Key and URL are handed out on site. The model is fixed for every team.
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=claude-haiku-4.5
# Optional: 1 = never send temperature (only if dev_tools/probe_gateway.py reports "temperature 0 accepted: NO").
# Without it the judge still works: a 400 that rejects temperature is resent without it.
# JUDGE_LLM_OMIT_TEMPERATURE=1
